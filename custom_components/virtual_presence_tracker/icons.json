{
  "entity": {
    "binary_sensor": {
      "only_virtual_home": {
        "default": "mdi:home-outline",
        "state": {
          "on": "mdi:home-account"
        }
      }
    },
    "event": {
      "prompt": {
        "default": "mdi:comment-question-outline"
      }
    },
    "switch": {
      "at_home": {
        "default": "mdi:home-account",
        "state": {
          "off": "mdi:home-outline"
        }
      }
    }
  },
  "services": {
    "answer_prompt": {
      "service": "mdi:comment-check-outline"
    },
    "open_prompt": {
      "service": "mdi:comment-question"
    }
  }
}
